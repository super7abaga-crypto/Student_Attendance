DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=generate-a-long-random-secret-for-local-development
ATTENDANCE_SECRET=generate-a-separate-random-secret-at-least-48-characters-long
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave blank for local SQLite. Set a PostgreSQL URL when a local server is running.
DATABASE_URL=
DB_SSLMODE=prefer
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
MAX_LOCATION_ACCURACY_M=100
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# In production set REDIS_URL and CELERY_BROKER_URL to managed Redis URLs.
REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=0
LOG_LEVEL=INFO
